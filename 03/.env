# Backend only. Keep the real .env private. Do not use VITE_ for credentials.
# AI_CHAT_URL is the FULL POST URL, including any MaaS gateway prefix.
AI_PROVIDER=OpenShift AI MaaS
AI_CHAT_URL=https://maas.apps.ocp.2l9fq.sandbox511.opentlc.com/llm/qwen3-06b/v1/chat/completions
AI_MODEL=qwen3-06b
AI_API_KEY=<your-api-key>
AI_JSON_MODE=false
AI_TIMEOUT_SECONDS=90
# This served model's context window is only 1024 tokens; keep the response budget well
# below (context - prompt) or the gateway returns HTTP 400 "max_tokens ... too large".
AI_MAX_TOKENS=500

# Host browser port published by Compose. Container always uses 8080.
APP_PORT=8083
# Keep remote inference on HTTPS. Only needed for a trusted local container host.
AI_HTTP_ALLOWED_HOSTS=
