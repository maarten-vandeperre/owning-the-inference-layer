# Backend only. Keep the real .env private. Do not use VITE_ for credentials.
# AI_CHAT_URL is the FULL POST URL, including any MaaS gateway prefix.
AI_PROVIDER='OpenShift AI MaaS'
AI_CHAT_URL=https://maas.example.invalid/llm/your-model/v1/chat/completions
AI_MODEL=replace-with-served-model-id
AI_API_KEY=replace-with-your-maas-credential
AI_JSON_MODE=false
AI_TIMEOUT_SECONDS=90

# Host browser port published by Compose. Container always uses 8080.
APP_PORT=8080
# Keep remote inference on HTTPS. Only needed for a trusted local container host.
AI_HTTP_ALLOWED_HOSTS=
