# Backend only. Keep the real .env private. Do not use VITE_ for credentials.
# AI_CHAT_URL is the FULL POST URL, including any MaaS gateway prefix.
AI_PROVIDER='Podman AI Lab'
AI_CHAT_URL=http://host.containers.internal:8081/v1/chat/completions
AI_MODEL=replace-with-served-model-id
AI_API_KEY=
AI_JSON_MODE=false
AI_TIMEOUT_SECONDS=90

# Host browser port published by Compose. Container always uses 8080.
APP_PORT=8080
# 8081 is an example: use your AI Lab service's actual published port.
# localhost inside the app container is NOT the host model service.
AI_HTTP_ALLOWED_HOSTS=host.containers.internal

# Only used by compose.host.yaml (native Linux alternative).
AI_HOST_CHAT_URL=http://127.0.0.1:8081/v1/chat/completions
