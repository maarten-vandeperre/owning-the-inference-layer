# Backend only. Keep the real .env private. Do not use VITE_ for credentials.
# AI_CHAT_URL is the FULL POST URL, including any MaaS gateway prefix.
AI_PROVIDER='Podman AI Lab'
AI_CHAT_URL=http://host.containers.internal:54901/v1/chat/completions
AI_MODEL=/models/Qwen3-4B-Q4_K_M.gguf
# Non-empty placeholder: Quarkus rejects blank AI_API_KEY; AI Lab itself needs no auth.
AI_API_KEY=not-needed
AI_JSON_MODE=false
AI_TIMEOUT_SECONDS=90

# Host browser port published by Compose. Container always uses 8080.
APP_PORT=8080
# Use the AI Lab service's published port; localhost inside the app container is NOT the host.
AI_HTTP_ALLOWED_HOSTS=host.containers.internal

# Only used by compose.host.yaml (native Linux alternative).
AI_HOST_CHAT_URL=http://127.0.0.1:54901/v1/chat/completions
